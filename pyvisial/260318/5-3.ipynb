   "source": [
    "import pandas as pd\n",
    "price = pd.DataFrame({'fruit':['apple', 'grape', 'orange', 'orange'],\n",
    "                      'price':[8,7,9,11]})\n",
    "amount = pd.DataFrame({'fruit':['apple', 'grape', 'orange'], 'amout':[5,11,8]})\n",
    "display(price, amount, pd.merge(price, amount))"
   ]
