    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "df=pd.DataFrame({\n",
    "    'key1':['a','a','b','b','a'],\n",
    "    'key2':['yes','no','yes','yes','no'],\n",
    "    'data1':np.random.randn(5),\n",
    "    'data2':np.random.randn(5)})\n",
    "grouppk1=df.groupby('key2').mean(numeric_only=True)\n",
    "grouppk1"
   ]
